# Copy file này thành .env rồi chỉnh theo máy. .env không được commit.

# Thư mục gốc chứa raw/ và processed/ (mặc định: data/ trong repo)
CREDIT_RISK_DATA_DIR=data

# Nơi lưu output của mỗi lần chạy, theo run_id (mặc định: artifacts/ trong repo)
CREDIT_RISK_ARTIFACTS_DIR=artifacts

# Giới hạn RAM cho DuckDB. Máy 8 GB nên để khoảng 3GB; phần vượt sẽ ghi tạm ra đĩa.
CREDIT_RISK_DUCKDB_MEMORY_LIMIT=3GB
CREDIT_RISK_DUCKDB_THREADS=4
